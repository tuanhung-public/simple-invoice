# Copy to `.env` before `docker compose up`.
# Do NOT commit `.env` — only this example file belongs in git.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=simple_invoice
POSTGRES_PORT=5433

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=3600
API_PORT=3001
CORS_ORIGIN=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_PORT=3000

# Used by the NestJS app when running locally (outside Docker network)
DATABASE_URL=postgresql://postgres:change-me-db-password@localhost:5433/simple_invoice?schema=public
PORT=3001
